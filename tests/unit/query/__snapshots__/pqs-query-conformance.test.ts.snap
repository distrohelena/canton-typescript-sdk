exports[`PQS conformance harness > executes the 'typed JSON projections and nested bou…' canonical case through PQS with exact parameterized calls 1`] = `
[
  {
    "text": "select
  contract_row.contract_id as contract_id,
  coalesce(contract_row.creation_package_id, contract_package.id) as package_id,
  contract_row.payload,
  contract_row.witnesses,
  created_tx.offset::text as created_event_offset,
  created_tx.effective_at as created_at,
  archived_tx.offset::text as archived_event_offset,
  archived_tx.effective_at as archived_at,
  contract_row.archived_at_ix is null as active,
  coalesce(contract_row.creation_package_id, contract_package.id) as template_package_id,
  contract_tpe_row.module_name as template_module_name,
  contract_tpe_row.entity_name as template_entity_name,
  (select coalesce(jsonb_agg("exercises_limited".value), '[]'::jsonb) from (select jsonb_build_object('tpePk', "exercises"."tpe_pk", 'contractTpePk', "exercises"."contract_tpe_pk", 'exerciseEventPk', "exercises"."exercise_event_pk", 'exercisedAtIx', "exercises"."exercised_at_ix", 'contractId', "exercises"."contract_id", 'argument', "exercises"."argument", 'result', "exercises"."result", 'redactionId', "exercises"."redaction_id", 'packagePk', "exercises"."package_pk", 'controllers', "exercises"."controllers", 'lastDescendantNodeId', "exercises"."last_descendant_node_id", 'witnesses', "exercises"."witnesses", 'package', (select jsonb_build_object('id', "package"."id") from "public"."__packages" "package" where "package"."pk" = "exercises"."package_pk" and (true))) as value from "public"."__exercises" "exercises" where "exercises"."contract_id" = contract_row."contract_id" and (true) order by "exercises"."tpe_pk" asc, "exercises"."contract_tpe_pk" asc, "exercises"."exercise_event_pk" asc, "exercises"."contract_id" asc limit $2) "exercises_limited") as "exercises",
  contract_row.payload #>> $3::text[] as "owner",
  (contract_row.payload #>> $4::text[])::numeric::text as "amount",
  (contract_row.payload #>> $5::text[])::boolean as "enabled",
  (contract_row.payload #>> $6::text[])::timestamptz as "when"
from "public"."__contracts" contract_row
join "public"."__contract_tpe" contract_tpe_row on contract_tpe_row.pk = contract_row.tpe_pk
left join "public"."__transactions" created_tx on created_tx.ix = contract_row.created_at_ix
left join "public"."__transactions" archived_tx on archived_tx.ix = contract_row.archived_at_ix
left join "public"."__packages" contract_package on contract_package.pk = contract_row.package_pk
where contract_row.contract_id = $1
 order by contract_row.contract_id asc

",
    "values": [
      "C1",
      1,
      [
        "owner",
      ],
      [
        "amount",
      ],
      [
        "enabled",
      ],
      [
        "when",
      ],
    ],
  },
]
`;

