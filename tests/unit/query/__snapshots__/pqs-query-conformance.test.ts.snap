exports[`PQS conformance harness > executes the 'scalar, JSON, array, and relation pre…' canonical case through PQS with exact parameterized calls 1`] = `
[
  {
    "text": "select
  contract_row.contract_id as contract_id,
  coalesce(contract_row.creation_package_id, contract_package.id) as package_id,
  contract_row.payload,
  contract_row.witnesses,
  created_tx.offset::text as created_event_offset,
  created_tx.effective_at as created_at,
  archived_tx.offset::text as archived_event_offset,
  archived_tx.effective_at as archived_at,
  contract_row.archived_at_ix is null as active,
  coalesce(contract_row.creation_package_id, contract_package.id) as template_package_id,
  contract_tpe_row.module_name as template_module_name,
  contract_tpe_row.entity_name as template_entity_name
from "public"."__contracts" contract_row
join "public"."__contract_tpe" contract_tpe_row on contract_tpe_row.pk = contract_row.tpe_pk
left join "public"."__transactions" created_tx on created_tx.ix = contract_row.created_at_ix
left join "public"."__transactions" archived_tx on archived_tx.ix = contract_row.archived_at_ix
left join "public"."__packages" contract_package on contract_package.pk = contract_row.package_pk
where (contract_row.contract_id like $1 and contract_row.payload #>> $2::text[] ilike $3 and $4 = any(contract_row.witnesses) and exists (select 1 from "public"."__exercises" "exercises" where "exercises"."contract_id" = contract_row."contract_id" and ($5 = any("exercises"."controllers"))))
 order by contract_row.contract_id asc

",
    "values": [
      "C_",
      [
        "owner",
      ],
      "ali%",
      "Alice",
      "Alice",
    ],
  },
]
`;

